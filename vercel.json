{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/proxy.js",
      "methods": ["GET", "POST", "OPTIONS", "DELETE"],
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, OPTIONS, DELETE",
        "Access-Control-Allow-Headers": "Content-Type, Accept, Authorization"
      }
    }
  ]
}
